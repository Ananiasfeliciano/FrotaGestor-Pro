{
  "name": "frotagestor-pro-sistema-de-gestao-de-frotas",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema de Gestão de Frotas — SARTINFO",
  "author": "SARTINFO",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:3000 && electron .\"",
    "electron:pack": "npm run build && electron-packager . \"FrotaGestor Pro\" --platform=win32 --arch=x64 --out=release --overwrite --asar --prune=true --ignore=\"^/\\.git\"",
    "generate-icon": "node build/generate-icon.cjs",
    "installer": "npm run generate-icon && npm run build && electron-builder --win --config electron-builder.config.cjs",
    "installer:dir": "npm run generate-icon && npm run build && electron-builder --win --dir --config electron-builder.config.cjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.19",
    "chart.js": "^4.5.1",
    "concurrently": "^9.2.1",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2",
    "lucide-react": "^0.562.0",
    "postcss": "^8.4.38",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.3",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  }
}
