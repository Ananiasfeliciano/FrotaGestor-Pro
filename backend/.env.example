# ── Servidor ──────────────────────────────────
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# ── JWT ───────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_64_CHARS
JWT_EXPIRES_IN=8h

# ── PostgreSQL ────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=frotagestor
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=frotagestor_pro

# ── Redis ─────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── Firebase (sync legado) ────────────────────
FIREBASE_DATABASE_URL=https://frotagestor-pro-sync-default-rtdb.firebaseio.com

# ── CORS ──────────────────────────────────────
CORS_ORIGINS=https://frotagestor-pro.vercel.app,http://localhost:3000

# ── Logging ───────────────────────────────────
LOG_LEVEL=info
